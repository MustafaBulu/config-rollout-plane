{
  "tenant_id": "payments",
  "key": "payment.failure_rate",
  "environment": "production",
  "candidate_version": 2,
  "target_services": [
    "payment-service"
  ],
  "stages": [
    {
      "id": "stage-5",
      "percentage": 5,
      "minimum_duration_seconds": 10
    },
    {
      "id": "stage-25",
      "percentage": 25,
      "minimum_duration_seconds": 20
    },
    {
      "id": "stage-100",
      "percentage": 100,
      "minimum_duration_seconds": 30
    }
  ],
  "guardrails": [
    {
      "name": "candidate-error-rate",
      "query": "sum(rate(payment_requests_total{config_version=\"2\",result=\"error\"}[30s])) / clamp_min(sum(rate(payment_requests_total{config_version=\"2\"}[30s])), 1)",
      "operator": "<",
      "threshold": 0.05,
      "consecutive_failures": 2
    }
  ],
  "required_ack_percentage": 90,
  "deployment_timeout_seconds": 60,
  "rollout_max_duration_seconds": 300,
  "rollback_timeout_seconds": 120
}
